		{"id":"ffe3ce0d4482bf75","type":"text","text":"追求脱离危机","x":-690,"y":4660,"width":160,"height":50,"color":"5"},
		{"id":"428c180a53374d55","type":"text","text":"产生脱离危机的目标","x":-1007,"y":4660,"width":226,"height":50,"color":"2"},
		{"id":"8789561f5abaf859","type":"text","text":"目标产生","x":-1301,"y":4915,"width":140,"height":50,"color":"3"},
		{"id":"a62e64dea1894830","type":"text","text":"追求目标实现","x":-1097,"y":4915,"width":176,"height":50,"color":"2"},
		{"id":"f83bba74ea67f522","type":"text","text":"收获","x":-161,"y":4915,"width":250,"height":50,"color":"6"},
		{"id":"03cf49d41b8f78e8","type":"text","text":"装逼","x":-781,"y":4915,"width":283,"height":50,"color":"5"},
		{"id":"a3aa72df0310c6e6","type":"text","text":"因装逼引发更装更大逼的可能","x":-781,"y":5020,"width":283,"height":50,"color":"5"},
		{"id":"3686034a276d6fd5","type":"text","text":"目标实现","x":-393,"y":4915,"width":136,"height":50,"color":"4"},
		{"id":"019776e1061f6558","type":"text","text":"收获\n","x":-161,"y":5260,"width":250,"height":50,"color":"6"},
		{"id":"e9bf984f9033ee5f","type":"text","text":"目标出现，该目标可导致谜团探明","x":-944,"y":5260,"width":326,"height":50,"color":"2"},
		{"id":"b4c778fe143dc4b4","type":"text","text":"谜团探明","x":-507,"y":5260,"width":250,"height":50,"color":"4"},
		{"id":"572b6362b6ee77be","type":"text","text":"谜团出现或重提","x":-1301,"y":5260,"width":250,"height":50,"color":"3"},
		{"id":"6dcd01421459c4fe","type":"text","text":"主角取得收获","x":-161,"y":5501,"width":250,"height":50,"color":"6"},
		{"id":"1649524a435ad1cf","type":"text","text":"某种收获被提及","x":-1301,"y":5501,"width":250,"height":50,"color":"3"},
		{"id":"6a653c56b33ba903","type":"text","text":"目标出现，该目标可导致主角取得收获","x":-782,"y":5501,"width":389,"height":50,"color":"2"},
		{"id":"ea3cc14746be09dd","type":"text","text":"收获","x":-161,"y":5720,"width":250,"height":60,"color":"6"},
		{"id":"6c9216ee37969c0d","type":"text","text":"主角发现或遇到不公不正的人事物","x":-1301,"y":5720,"width":321,"height":60,"color":"3"},
		{"id":"1d48ce4a924ae718","type":"text","text":"目标出现，目标可能导致主角消灭不公不正的状态","x":-907,"y":5720,"width":250,"height":60,"color":"2"},
		{"id":"b0f48e4016c77085","type":"text","text":"主角消灭这种不公不正状态，导致不公不义产生的人因主角行受到惩罚","x":-578,"y":5720,"width":321,"height":60,"color":"4"},
		{"id":"671604671d8759cb","type":"text","text":"收获","x":-161,"y":4240,"width":250,"height":50,"color":"6"},
		{"id":"076e2847c041efe1","type":"text","text":"追求目标实现","x":-1125,"y":4359,"width":160,"height":50,"color":"2"},
		{"id":"c1ea814a9b61384e","type":"text","text":"结构一定要和故事卡结合才能产生好看的故事。","x":-1358,"y":4000,"width":1498,"height":140,"color":"2"},
		{"id":"742f5778696af34c","type":"text","text":"事业线的核心是目标，叙事主角自己的目标，或者帮助他人实现目他人的目标。\n事业线的结构都可以以同一目标为基础进行合并。","x":-1359,"y":3800,"width":1498,"height":120,"color":"2"},
		{"id":"309e3e120789035d","type":"text","text":"新的阻碣出现","x":-444,"y":4360,"width":163,"height":50,"color":"4"},
		{"id":"eb7dc50eac690607","type":"text","text":"这个节点也可以搭配争风吃醋结构来写，通过刻意让对方吃醋，来验证对方对自己的态度。\n也可通过好感度变化结构，专门为对方设计一定的考验，或者一定事情上的试探，通过对方能否通过考验或者是否对于试探做出特定的反应，从而确定对方的心意，还附带提升了好感度。","x":-480,"y":10880,"width":560,"height":161,"color":"3"},
		{"id":"79375f40911c128c","type":"text","text":"进入熟悉阶段或让读者熟悉人物角色","x":-797,"y":10250,"width":200,"height":60,"color":"4"},
		{"id":"d392747d45c5e222","type":"text","text":"①外观形象    ②性格    ③他人对其的评价","x":-460,"y":10320,"width":520,"height":80,"color":"3"},
		{"id":"a5599686bdb3cee7","type":"text","text":"①性格以外的其他行为模式部分    ②形成其行为模式的经历    \n③其他部分人际关系","x":-460,"y":10450,"width":520,"height":80},
		{"id":"b4af2fb0133ef825","type":"text","text":"可选","x":-961,"y":10862,"width":101,"height":60},
		{"id":"1213d59ac9203316","type":"text","text":"进入暧昧阶段","x":-760,"y":10862,"width":163,"height":60,"color":"4"},
		{"id":"444962fc5454d300","type":"text","text":"发狗粮","x":-939,"y":11041,"width":128,"height":50,"color":"#abe15b"},
		{"id":"e7392686b6ad32c4","type":"text","text":"有分寸地试探对方能否接受自己进行CP行为","x":-824,"y":10961,"width":227,"height":50,"color":"6"},
		{"id":"803814a7082bf917","type":"text","text":"阻碍","x":-781,"y":11041,"width":184,"height":50,"color":"#ea8add"},
		{"id":"91f2b93f30850eb8","type":"text","text":"失败","x":-1104,"y":11514,"width":102,"height":50,"color":"4"},
		{"id":"38cbe8592529c137","type":"text","text":"负好感度","x":-1260,"y":9760,"width":210,"height":50,"color":"3"},
		{"id":"0ee420df5e5c63e5","type":"text","text":"熟悉阶段","x":-1260,"y":9900,"width":440,"height":50,"color":"3"},
		{"id":"5d1a799d5a13252f","type":"text","text":"零好感度","x":-1050,"y":9760,"width":230,"height":50,"color":"3"},
		{"id":"9506ad6073bac045","type":"text","text":"满好感度\n","x":-360,"y":9760,"width":480,"height":50,"color":"1"},
		{"id":"459b6deafe3b1c18","type":"text","text":"确认关系阶段\n","x":-360,"y":9900,"width":480,"height":50,"color":"1"},
		{"id":"0c1b8324776c68e0","type":"text","text":"半好感度","x":-820,"y":9760,"width":460,"height":50,"color":"2"},
		{"id":"b9666007fdc5d262","type":"text","text":"暧昧阶段\n","x":-590,"y":9900,"width":230,"height":50,"color":"2"},
		{"id":"d8b11f2dff8b13a7","type":"text","text":"试探阶段","x":-820,"y":9900,"width":230,"height":50,"color":"2"},
		{"id":"3072d7c874316955","type":"text","text":"试探对方态度","x":-1272,"y":10961,"width":168,"height":50,"color":"3"},
		{"id":"fe85669acc531583","type":"text","text":"示爱行为","x":-1272,"y":11041,"width":132,"height":50,"color":"1"},
		{"id":"b093001f94370f99","type":"text","text":"关爱对方","x":-1108,"y":11041,"width":130,"height":50,"color":"5"},
		{"id":"de0cbb340fb5722d","type":"text","text":"确定自己的感情\n","x":-1050,"y":10961,"width":179,"height":50,"color":"2"},
		{"id":"f5c9bf317c6eade3","type":"text","text":"在好感度已经达到半好感度以上后，可以使用“发狗粮”节点，即“两人了间进行CP行为，了或者一方接受了对方的CP行为中的特殊对待行为后十分触动甚至感动，并好感度大增”。","x":-480,"y":11156,"width":560,"height":100,"color":"#bfea62"},
		{"id":"b42a25ecfd5501f0","type":"text","text":"成功\n","x":-1104,"y":11355,"width":102,"height":50,"color":"2"},
		{"id":"ae17f273fdeccf89","type":"text","text":"对方原本是满好感度，直接进入确认关系阶段","x":-939,"y":11304,"width":329,"height":76,"color":"2"},
		{"id":"1943d1169700bb10","type":"text","text":"对方原本是半好感度，好感提升，但一般会犹豫是否进入下一阶段","x":-939,"y":11389,"width":329,"height":66,"color":"2"},
		{"id":"ce51e325039e5dfc","type":"text","text":"因好感度不足被拒绝，对方好感度一般会下降","x":-933,"y":11469,"width":323,"height":70,"color":"4"},
		{"id":"10cac43ff9c77123","type":"text","text":"因好感度以外的原因被拒绝，对方好感度一般会上升","x":-933,"y":11559,"width":323,"height":61,"color":"4"},
		{"id":"c84763c194553eb1","type":"text","text":"两人关系不能顺利进入下一个两人关系所处阶段的阻碍（主要是不能确认或者误解对方心意的阻碍或者不能将自己心意传达给对方的阻，这些阻碍进一步进化成妨碍两人从熟悉阶段或者试探阶段到暖昧阶段的阻碍。）或最两人现有的关系或者相处状态遇到被破坏性改变的危机。\n\n此处阻碍通常是不能顺利提升对方好感度的阻碍。\n\n此处的两人关系一般是准爱情关系。","x":-480,"y":11408,"width":560,"height":232,"color":"#ea95e3"},
		{"id":"e48bde9c14d715fd","type":"text","text":"处于暧昧阶段","x":-1317,"y":11769,"width":177,"height":50,"color":"4"},
		{"id":"51c98bc1b573ffb5","type":"text","text":"阻碍（可选）","x":-1053,"y":11769,"width":158,"height":50,"color":"3"},
		{"id":"b52eee38ed6a7b21","type":"text","text":"进入确认关系阶段","x":-811,"y":11769,"width":214,"height":50,"color":"4"},
		{"id":"ccb620432e24ee74","type":"text","text":"在这个阶段中，进入**确认关系阶段**是必有节点，两人处于**暧昧阶段**是这个阶段的开始的必备条件。","x":-1317,"y":11849,"width":720,"height":125,"color":"4"},
		{"id":"0ddf7d54bb9824dc","type":"text","text":"处于熟悉或者试探阶段","x":-1317,"y":10862,"width":250,"height":60,"color":"4"},
		{"id":"93acedac1213d2f9","type":"text","text":"在此阶段中，进人**暧昧阶段**是必有节点，两个人处于**熟悉阶段**或者**试探阶段**是前提。\n若两个人出场时已经处于暖昧阶段以上阶段，那爱情喜剧阶段便不必写。","x":-1317,"y":11140,"width":720,"height":80,"color":"4"},
		{"id":"7174970429b10b0e","type":"text","text":"示爱结果","x":-1299,"y":11430,"width":139,"height":50,"color":"1"},
		{"id":"fded2928236fbeb6","type":"text","text":"可选节点","x":-1218,"y":10360,"width":132,"height":50,"color":"3"},
		{"id":"eeaf3f66b18f4f2e","type":"text","text":"攻略行为","x":-1063,"y":10360,"width":133,"height":50,"color":"6"},
		{"id":"afa706a5fc26407d","type":"text","text":"天降红绳","x":-912,"y":10360,"width":138,"height":50,"color":"2"},
		{"id":"820842d1a8bd20cb","type":"text","text":"这个节点中，角色提升或者试图提升对方好感度的行为，即攻略行为。\n- 主动攻略行为： 角色的行动目标就是提高对方好感度。\n       （主动攻略行为的前提是角色对对方满好感度才会进行，除非有该爱情线以外的原因。）\n- 被动攻略行为： 角色的行为不以提升好感度为目标，但客观上提高了对方的好感度。\n","x":-1317,"y":10580,"width":720,"height":160},
		{"id":"1b121bf77cdd198c","type":"text","text":"若两人本来交集不多或者没有交集，甚至距离极远，此阶段中还可以为是后能够经常接触提供一系列节点（往往使用的是天降红绳八法）。","x":-480,"y":10620,"width":560,"height":120,"color":"2"},
		{"id":"bf8c1a7a2eeb85f3","type":"text","text":"**人物登场**和**进入熟悉阶段或者让读者熟悉人物**是必有节点，即使设定上两人故事开始已是熟悉阶段，也要安排一系列剧情让读者熟悉人物角色。","x":-1317,"y":10430,"width":720,"height":100,"color":"4"},
		{"id":"c8dced3d61212213","type":"text","text":"爱情喜剧阶段","x":-860,"y":10040,"width":270,"height":50,"color":"5"},
		{"id":"4f18dabbd72ebe49","type":"text","text":"人物登场","x":-1317,"y":10250,"width":136,"height":60,"color":"4"},
		{"id":"153924a9704d86da","type":"text","text":"可选","x":-1063,"y":10250,"width":133,"height":60},
		{"id":"f584ccfa7a672557","type":"text","text":"萍水相逢阶段","x":-1340,"y":10040,"width":300,"height":50,"color":"5"},
		{"id":"e1253e55684bbcf2","type":"text","text":"大结局阶段","x":-50,"y":10040,"width":170,"height":50,"color":"5"},
		{"id":"d60281c838fdabab","type":"text","text":"爱隔山海阶段","x":-520,"y":10040,"width":160,"height":50,"color":"5"},
		{"id":"08e80bf4ee8420ac","type":"text","text":"处于确认关系阶段","x":-1317,"y":12079,"width":209,"height":50,"color":"4"},
		{"id":"391a6ccce5ffcc56","type":"text","text":"**大结局**是这个阶段的固定节点，两个人进入**确认关系阶段**是这个阶段的前提。","x":-1317,"y":12259,"width":720,"height":60,"color":"4"},
		{"id":"6770bc8fdfeeed97","type":"text","text":"危机","x":-1084,"y":12149,"width":110,"height":50,"color":"2"},
		{"id":"d907402fffd5271f","type":"text","text":"可选节点","x":-1002,"y":12079,"width":167,"height":50},
		{"id":"f510ca31b181672e","type":"text","text":"新变化","x":-933,"y":12149,"width":125,"height":50,"color":"6"},
		{"id":"07657e864186226b","type":"text","text":"大结局","x":-740,"y":12079,"width":143,"height":50,"color":"4"},
		{"id":"952c940800dd90ba","type":"text","text":"可以在这个阶段打上出现两人关系不能顺利进入下一个两人关系所处阶段的阻碍（主要是不能进一步确认为情侣或者夫妻关系或者告知他人两人的情侣或者夫妻关系的阻碍）或者两人现有的关系或者相处状态遇到被破坏性改变的节点。\n此处的阻碍通常是两人诉心意并且顺利接受对方的心意的一系列阻碍。\n此处的两人关系一般是准爱情关系。","x":-480,"y":11789,"width":560,"height":185,"color":"3"},
		{"id":"92f4e6906c63404b","type":"text","text":"可以在这个阶段打上出现两人现有的关系或者相处状态遇到被破坏性改变的危机的节点。\n此处的两人关系一般是爱情关系甚至婚姻关系。","x":-480,"y":12109,"width":560,"height":90,"color":"2"},
		{"id":"874f1e7aff30b527","type":"text","text":"可以在这个阶段打上出现两人状态发生变化和因两人的状态导致其关系发生新变化的节点。","x":-480,"y":12239,"width":560,"height":80,"color":"6"},
		{"id":"eac4c9960390f9c0","type":"text","text":"- 好感度： 好感度是双向的，即 A ➜ B 有好感度， B ➜ A 也有好感度。\n- 两人所处关系阶段： 关系阶段是和好感度对应的，并且只有互相好感度都达到才能进入下一阶段。比如两人都对对方满好感度才是确认关系阶段，一个满好感，一个人零好感，依然是熟悉阶段。\n- 爱情线阶段： 好感度和关系阶段是一种状态，而爱情线阶段是爱情线的本体。通过爱情线上一系列的节点发生故事，两人的好感度发生变化，从而使两人的关系发生变化。\n\n爱情线阶段和两人关系阶段的对应： 两人的关系是一种状态，不管是在爱情线节点里，还是在事业线节点里，都是一直存在的。大多数情况，我们都是既写爱情线也写事业线，爱情线是和事业线交叉分布的，所以爱情线阶段在整个剧情里看起来可能是不连续的。爱情线阶段就是使好感度度和关系发生变化的源头，爱情线阶段的目标，就是使两人的阶段关系变化。\n\n后阶段可以用前阶段，前阶段不能用后阶段。\n\n","x":-1340,"y":9460,"width":1460,"height":240},
		{"id":"328d4f94ef8fa5fe","type":"text","text":"核心梗的设计本质上就是特定故事卡和特定素材的结合，并且这个结合有足够的吸引目标读者读完全书的戏剧性。\n\n反复出现的核心梗要在所有一级结构中都有所体现，只出现一次的核心梗则不用。\n\n反复出现的核心梗和双线法结合，可以避免重复。","x":-1336,"y":12460,"width":1456,"height":140},
		{"id":"04ffbc4d032c5b24","type":"text","text":"有目的或被迫的去做一件可能有危险的事都算，不一定是一个地方。\n传统的冒险之旅一般还会结合解谜和寻宝之路。","x":-2720,"y":-1220,"width":1000,"height":80,"color":"1"},
		{"id":"b25f7acd5e35e44a","type":"text","text":"冒险开始前，往往需要对该冒险中的危险进行铺垫或者渲染。若是去危险地方冒险，可通过以下途径对该地方的危险进行渲染。","x":-2340,"y":-1063,"width":260,"height":166,"color":"6"},
		{"id":"ac7ae7a84bd10a15","type":"text","text":"通过隐喻的方法来讲述该地方的危险。例如讲述和该地方相关的神话或传说，通常是带有警告甚至恐怖色彩那种。","x":-2340,"y":-840,"width":260,"height":150},
		{"id":"6a3847411e4417e4","type":"text","text":"即角色在故事中发生成长，主要包括人格上的成长和能力上的成长。","x":-2717,"y":60,"width":997,"height":50,"color":"2"},
		{"id":"9ff4a07479eb2e69","type":"text","text":"由于种种原因，主动以身犯险，为角色承担本应出现在角色身上的损害，这样既能让读者意识到该险境的危险，又能避免让角色受到无法弥补的损害。\n\n这种反派往往实力上要比角色强，准备上要比角色足，才能给角色足够的压力，同时在面对危险时，有比角色更强的承受能力，方能起到替角色承担危险的作用。","x":-1998,"y":-437,"width":260,"height":355},
		{"id":"7255e95a85187354","type":"text","text":"在角色未能为冒险做充足的准备或者准备上有缺失时，通过中途与角色之间的各种接触和竞争，让角色在其身上拿到所需要准备而未能准备的人事物。","x":-1998,"y":-682,"width":260,"height":185},
		{"id":"fc96e12970146371","type":"text","text":"催促甚至逼迫角色在冒险中进入下一个环节或者走的更远，在角色缺乏进一步冒险的理由时，推角一把。","x":-1998,"y":-863,"width":260,"height":126},
		{"id":"3aa3cd23f2e44fc5","type":"text","text":"冒险之旅中可以设计同为冒险者的反派。这种反派和角色是竞争关系，和角色竞争冒险之旅的奖励。","x":-1998,"y":-1063,"width":260,"height":130,"color":"6"},
		{"id":"6434df5051e93f45","type":"text","text":"描述该地方的景象让人感到危险。","x":-2339,"y":-142,"width":260,"height":60},
		{"id":"900d911e45610160","type":"text","text":"由于角色的冒险经历和或得的好处，日常生活发生改变。","x":-2698,"y":-142,"width":280,"height":60},
		{"id":"ddd64eecb7ee9913","type":"text","text":"直接陈述该地方全部或者部分之危险。（效果相对没有那么好，慎用）","x":-2339,"y":-620,"width":260,"height":90},
		{"id":"d810d819518a1c7c","type":"text","text":"描述曾去过该地方的人的下场。（角色听说或者直接接触过这些人）","x":-2338,"y":-457,"width":259,"height":100},
		{"id":"19122e91f190837c","type":"text","text":"描述该地方的一些异常情况。（让角色从打听等途径得知）","x":-2339,"y":-300,"width":258,"height":95},
		{"id":"4d397b6c5b91c0c4","type":"text","text":"回到原来的日常或矛盾中去","x":-2698,"y":-259,"width":280,"height":50},
		{"id":"c805952681c40bb6","type":"text","text":"不是指现实普通人的日常，是对于角色的日常。","x":-2698,"y":-1020,"width":280,"height":60},
		{"id":"80cb298a021de39d","type":"text","text":"自己主动或形势所迫。","x":-2698,"y":-891,"width":280,"height":50},
		{"id":"1e6805f100351bee","type":"text","text":"①装备上的准备 ②能力上的准备 ③心理上的准备 ④人手上的准备 ⑤知识上的准备","x":-2698,"y":-782,"width":280,"height":100},
		{"id":"56fb986ae0b0c62e","type":"text","text":"一般情况，角色不能中途中止或退出冒险。","x":-2698,"y":-620,"width":280,"height":60},
		{"id":"6908a51057bdf722","type":"text","text":"角色一路上越发接近核心危险，或者危险越来越大。","x":-2698,"y":-497,"width":280,"height":60},
		{"id":"77c75426781ac200","type":"text","text":"角色取得了这次冒险最核心的好处。","x":-2698,"y":-387,"width":280,"height":60},
		{"id":"2cd2d993411c47c1","type":"text","text":"即人物随着情节的发展而产生了一定的行为模式上的改变（人物弧光、黑化）。这种设计的写作难度较大，而且同一个人物每进行一次人格成长，对于其的刻画难度就指数级别的增长，所以新手比较建议一个人物只写一次人格成长，而且最好一本书只写一次。\n\n人格成长可以分为主动型和被动型，这两种人格成长的可选点：\n- 主动型： 成长或者改变的动机出现➜设法改变➜改变成功，新行为模式形成（这一种基本就是基本构造的应用）。\n- 被动型： 原行为模式（阶段）➜刺激事件，又称压力事件（若干契机性的事件）➜反思/反应（即人物对于每一次刺激事件的反应，改心理描写为主，并且可以用相应的行为来突出其心理活动）➜产生变化（这里可以设计一个给角色的抉择，其中有两个选项分别代表着旧的行为的模式和新的行为模式，通过角色选择了新的行为模式来体现角色的成长）➜新行为模式（阶段）","x":-2701,"y":180,"width":960,"height":260,"color":"4"},
		{"id":"5e4dafb46a8fd855","type":"text","text":"- 行为模式中的个人特质发生增加、变化或者减少。\n- 组成行为模式中的性格的性格卡或者属性发生增加、变化或者减少。\n- 行为模式中的具体价值取向发生变化，既可以是同一种价值取向内部的变化，也可以是不同种价值取向之间的变化。","x":-2702,"y":480,"width":960,"height":110,"color":"5"},
		{"id":"f5e6580a4c4450da","type":"text","text":"即角色拥有的“神器”或者“宝物”的数目增加，或者已拥有的“神器”或者“宝物”成长，又或者解锁了已有“神器”或者“宝物”的新用法。\n\n- 主动型： 即角色主动去追求拥有的“神器”或者“宝物”的数目增加，或者已拥有的“神器”或者“宝物”成长，又或者解锁已有“神器”或者“宝物”的新用法。其故事点可以直接适用基本构造法。\n     注：在叙事主角主动追求能力上的成长的这一段剧情上，追求能力上的成长不能是他唯一的短期目标，要么他主动追求能力上的成长这一目标是为了其他紧迫的短期目标而服务，要么是他同时拥有多个短期目标。（否则会因为缺乏矛盾冲突，而便得剧情缺乏吸引力。）（简而言之，即不能为了变强而变强，也不能只为了一个遥远的长期目标而变强。）\n- 被动型： 即角色并未主动追求能力上的成长，但机缘巧合之下得到了能力上的成长。\n\n当写叙事主角以外的角色的成长的时候，要注意其成长不能是独立于叙事主角的一条故事线，这会给人一种叙事主角发生偏侈的感觉。\n叙事主角以外的角色的成长，一定要和叙事主角本身产生较大的联系：\n- 因为受到叙事主角或者叙事主角的行为的影响，从而其他角色产生了成长。\n- 其他角色的成长最终影响到了叙事主角的事业线或者爱情线的发展。","x":-2717,"y":660,"width":997,"height":408,"color":"6"},
		{"id":"5fa3e96159cde975","type":"text","text":"外貌、身高、体魄、性格、敏捷、力量等","x":-2760,"y":1316,"width":250,"height":60},
		{"id":"cfd1a2dda1e90bf8","type":"text","text":"可攻略对象、同伴、老师、家人、宠物等","x":-2760,"y":1457,"width":250,"height":60},
		{"id":"28b148f882c07619","type":"text","text":"人脉","x":-2401,"y":1457,"width":135,"height":60,"color":"5"},
		{"id":"89295abb9509dba9","type":"text","text":"环境","x":-2401,"y":1672,"width":135,"height":60,"color":"5"},
		{"id":"c92680fba172a3d4","type":"text","text":"基本属性","x":-2400,"y":1316,"width":135,"height":60,"color":"5"},
		{"id":"dfc6e79f82fb9306","type":"text","text":"经济水平","x":-2400,"y":1387,"width":135,"height":60,"color":"5"},
		{"id":"56e82aa15de4b459","type":"text","text":"地位身份","x":-2400,"y":1528,"width":135,"height":60,"color":"5"},
		{"id":"3e99d4a859137795","type":"text","text":"声誉名誉","x":-2400,"y":1599,"width":135,"height":60,"color":"5"},
		{"id":"484849e1ecc5919a","type":"text","text":"①任何能让人争夺或者争取，但只有少数人甚至唯一一个人可以得到，得到之后会让人羡慕嫉妒恨的东西。\n\n②得到后能够满足读者虚荣心的东西。\n\n③得到后能够给角色带来明显好处的东西。\n\n以上必须全部符合","x":-2100,"y":1320,"width":400,"height":240,"color":"6"},
		{"id":"28aa0dbfcd165ebf","type":"text","text":"技能、招式、超能力等","x":-2760,"y":1180,"width":250,"height":60},
		{"id":"59f8de4388593824","type":"text","text":"能力","x":-2400,"y":1180,"width":135,"height":60,"color":"5"},
		{"id":"3f917b64c26f2937","type":"text","text":"道具","x":-2401,"y":1248,"width":135,"height":60,"color":"5"},
		{"id":"718a6dcffcfb3c3f","type":"text","text":"在故事中设置一些谜团、悬念或者读者不知道的核心信息等，再通过角色不断地收集信息，并在此基础上进行思考和推理，从而揭开它们。（本质上就是信息差的一种实际应用）\n\n可以把世界观设定、人物前史、事件起因等本身比较枯燥无味的东西用谜团的方式来进行设计，这样就能减少读者看到这类东西的排斥程度。\n\n若一旦解谜成功就会进得巨大的好处，了或者一旦出错就会导致严重的后果，就能大大加强读者对解谜结果的期待感。","x":-2576,"y":1890,"width":1000,"height":180,"color":"2"},
		{"id":"c52fde28197b3091","type":"text","text":"寻找线索","x":-2558,"y":2145,"width":137,"height":50},
		{"id":"aa87d5cb7b90d7a2","type":"text","text":"基于线索展开设想","x":-2558,"y":2270,"width":200,"height":50},
		{"id":"8aff7c56b6159d12","type":"text","text":"找一个“碎片”作为角色最开始的切入口。","x":-2249,"y":2690,"width":353,"height":50},
		{"id":"ee41cbe97a5b1a44","type":"text","text":"角色从切入口出发，不断得到和积累各种“碎片”。（找到每个“碎片”的具体过程。可以设计误导性“碎片”为反转留下伏笔。）","x":-2533,"y":2765,"width":922,"height":50},
		{"id":"167c4372e171509e","type":"text","text":"角色通过逻辑整理得到的“碎片”，产生猜想（但此时仍未能确定哪个猜想正确）","x":-2378,"y":2850,"width":611,"height":50},
		{"id":"fc9adfbc1d89c401","type":"text","text":"角色通过不断的验证或者收集“碎片”，不断推翻已有假想或者创立新的假想，最终确定了某种假想就是现实。","x":-2483,"y":2925,"width":822,"height":50},
		{"id":"e9f8a6e8ec87ddfb","type":"text","text":"得到线索","x":-2368,"y":2145,"width":137,"height":50},
		{"id":"65735d43f8b3f6bf","type":"text","text":"验证设想是否成立","x":-2323,"y":2270,"width":200,"height":50},
		{"id":"e4f871d49d04e8e2","type":"text","text":"成立：结合其他情报确定谜底，或者下一步收集证据方向。","x":-2066,"y":2145,"width":468,"height":50},
		{"id":"7dbf691d30b5da8d","type":"text","text":"不成立：重新设想甚至重新收集线索。","x":-2066,"y":2270,"width":468,"height":50},
		{"id":"0b212c6419b7cd1e","type":"text","text":"- 未知性： 即读者和角色不知道谜底是啥。\n- 可能性： 即必须要传达给读者对于未知的部分有数种可能的猜想，需要角色调查或推理来验证。（主要通过人物的心理活动、情节或者线索等来进行引导读者产生相应的猜想。）\n- 压迫感： 即角色有解开该谜团的必要性。","x":-2578,"y":2390,"width":1000,"height":140},
		{"id":"f76a1f3cacc838bd","type":"text","text":"先构思好一个完整的事件或信息，再将其切割为若干“碎片”。","x":-2323,"y":2610,"width":501,"height":50},
		{"id":"60c0b7c87d9ed2d5","type":"text","text":"- 点式 ： 只写故事点所在的小故事，结构紧凑，难写长。\n- 流式 ： 不仅写故事点所在的小故事，并且在这些小故事之间塞了很多和这个一级结构无关的小故事，把这些小故事联系起来。","x":-1400,"y":9100,"width":1580,"height":80},
		{"id":"488d80aaf8f3f57a","type":"text","text":"把两套不同的故事点交叉分布。","x":-1400,"y":9260,"width":1580,"height":60},
		{"id":"b36ea02c59225967","type":"text","text":"事业线的层级相对自由，可以自己设计出很多个层级。\n\n- 主要角色的目标出现以及为了实现目标而进行的每一步行动。\n- 主要角色的里程碑式的状态（等级、职务等）。\n- 地图的更新。\n- 主要角色所处的利益团体的发展或者更换。\n- “神器”或“宝物”的取得及其发展。\n- 主要角色的登场和退场（即除功能性配角和跑龙套的以外的角色）。\n- 特定角色之间关系的发展。\n- 新矛盾源、矛盾、冲突的出现和矛盾、冲突的升级以及矛盾、矛盾源的消灭。\n- 戏剧性的出现或者升级。\n- 主角或者读者的预期被打破带来的剧情确定性忽然下降。\n- 大故事或者中故事中其他里程碑式的情节或者关键情节。","x":-1400,"y":5940,"width":1580,"height":400},
		{"id":"9d82f37b05abe962","type":"text","text":"已经下降","x":-959,"y":7169,"width":130,"height":50,"color":"2"},
		{"id":"4c66f1ac03ef7e10","type":"text","text":"阻止其下降","x":-734,"y":7070,"width":250,"height":50,"color":"5"},
		{"id":"b923227cc8d46e63","type":"text","text":"试图回复好感度","x":-734,"y":7169,"width":250,"height":50,"color":"5"},
		{"id":"bc2ea0f6dd48caf4","type":"text","text":"享受爱情关系","x":-580,"y":7380,"width":250,"height":60,"color":"4"},
		{"id":"807c912ebd5358d1","type":"text","text":"可攻略对象使用叙事主角进行装逼","x":-1298,"y":8660,"width":307,"height":50,"color":"3"},
		{"id":"43867383ec1996d6","type":"text","text":"两人间进行CP行为的可能或者预告","x":-1298,"y":8880,"width":312,"height":50,"color":"3"},
		{"id":"b79919463683fb1e","type":"text","text":"两人进行CP行为，引起围观或者读者的羡慕和快乐","x":-760,"y":8880,"width":426,"height":50,"color":"4"},
		{"id":"4cd46ea8c6800cc2","type":"text","text":"可攻略对象使用叙事主角进行装逼","x":-608,"y":8660,"width":307,"height":50,"color":"4"},
		{"id":"fb812ffffa8cbe9f","type":"text","text":"余韵（可选）","x":-70,"y":8880,"width":159,"height":50,"color":"1"},
		{"id":"4d07d37d19e53486","type":"text","text":"两人现有的关系或者相处状态遇到被破坏性改变的危机（准爱情关系、爱情关系、婚姻关系）","x":-1301,"y":8240,"width":463,"height":60,"color":"3"},
		{"id":"6ea91edf0d089311","type":"text","text":"叙事主角使用可攻略对象进行装逼","x":-1301,"y":8460,"width":310,"height":50,"color":"3"},
		{"id":"fd74e18ea26f9b88","type":"text","text":"的可能或预告","x":-1000,"y":8560,"width":160,"height":50,"color":"3"},
		{"id":"89adc0c1cfcf974b","type":"text","text":"试图解决该危机","x":-770,"y":8240,"width":250,"height":60,"color":"5"},
		{"id":"e46c1c6ea73d3dae","type":"text","text":"享受与可攻略对像接触带来的和爱情线相关的收益","x":-1301,"y":7570,"width":250,"height":60,"color":"3"},
		{"id":"2e3c3cfe5f0ba89e","type":"text","text":"争风吃醋的可能或者预告","x":-1301,"y":7800,"width":250,"height":50,"color":"3"},
		{"id":"e821af9849f01372","type":"text","text":"出现两人关系不能顺利进入下一个爱情阶段的阻碍","x":-1301,"y":8020,"width":421,"height":50,"color":"3"},
		{"id":"911a83d1311fc743","type":"text","text":"通过对爱情线双方或者一方的心理描写等，盘点爱情线中的双方或一方对于爱情线一级结构对应过程的想法和感受，以此进一步满足读者对于爱情体验的需求。\n\n余韵还可以有下列功能之一： \n- 明示或者暗示读者该角色对对方的好感度情况。\n- 以此为跳板顺便开始做下一次爱情线一级结构的铺垫。\n\n余韵可以不写，剧情节奏上有余裕最好写上。","x":-1359,"y":6640,"width":1499,"height":220,"color":"2"},
		{"id":"80957fc9d74ce600","type":"text","text":"可能提升","x":-959,"y":6974,"width":131,"height":50,"color":"2"},
		{"id":"902c2c673ffc141c","type":"text","text":"好感度产生发生变化的可能","x":-1301,"y":7070,"width":267,"height":50,"color":"3"},
		{"id":"6fab717cc1135e1f","type":"text","text":"的可能或者预告","x":-1078,"y":7475,"width":250,"height":60,"color":"3"},
		{"id":"0f71b0f0b21b3ad3","type":"text","text":"可能下降","x":-960,"y":7070,"width":131,"height":50,"color":"2"},
		{"id":"f672a48b64bd6c2a","type":"text","text":"享受爱情关系","x":-1301,"y":7380,"width":250,"height":60,"color":"3"},
		{"id":"994f6be01709e115","type":"text","text":"好感度不下降或提升\n","x":-417,"y":7070,"width":250,"height":50,"color":"4"},
		{"id":"6dafd1872d89b2d1","type":"text","text":"好感度恢复甚至提升","x":-417,"y":7169,"width":250,"height":50,"color":"4"},
		{"id":"0177bb673b1cf921","type":"text","text":"余韵（可选）","x":-70,"y":7070,"width":159,"height":50,"color":"1"},
		{"id":"c7f591ff62e40292","type":"text","text":"余韵（可选）","x":-70,"y":7480,"width":159,"height":50,"color":"1"},
		{"id":"622edab6927a0c23","type":"text","text":"好感度提升或不升\n","x":-417,"y":6974,"width":250,"height":50,"color":"4"},
		{"id":"5217490396e6dbd8","type":"text","text":"该阻碍被解决","x":-417,"y":8020,"width":250,"height":50,"color":"4"},
		{"id":"e2acdf770f1f6119","type":"text","text":"余韵（可选）","x":-70,"y":7800,"width":159,"height":50,"color":"1"},
		{"id":"e60acf7db1803f93","type":"text","text":"余韵（可选）","x":-70,"y":8020,"width":159,"height":50,"color":"1"},
		{"id":"c10723bf16a32710","type":"text","text":"叙事主角使用可攻略对象进行装逼","x":-608,"y":8460,"width":310,"height":50,"color":"4"},
		{"id":"319caab6f7837c44","type":"text","text":"该危机被解决","x":-417,"y":8240,"width":250,"height":60,"color":"4"},
		{"id":"079071fd6a5ead24","type":"text","text":"余韵（可选）","x":-70,"y":8243,"width":159,"height":55,"color":"1"},
		{"id":"434a55c6c75c6034","type":"text","text":"余韵（可选）","x":-70,"y":8560,"width":159,"height":50,"color":"1"},
		{"id":"8bd33229fe76c81a","type":"text","text":"争风吃醋（甚至产生矛盾）","x":-920,"y":7800,"width":250,"height":50,"color":"5"},
		{"id":"e159d98a04296c4e","type":"text","text":"试图去解决该阻碍","x":-770,"y":8020,"width":250,"height":50,"color":"5"},
		{"id":"640055a3b856b5dc","type":"text","text":"享受与可攻略对像接触带来的和爱情线相关的收益","x":-580,"y":7570,"width":250,"height":60,"color":"4"},
		{"id":"5a3a49e4edbc2790","type":"text","text":"解决争风吃醋带来的矛盾（可选）","x":-520,"y":7800,"width":302,"height":50,"color":"4"},
		{"id":"53e474eae428486f","type":"text","text":"CP行为，即与对方的好感度处于半好感度以上紧密相关的两个角色的专有互动。往往也是能够提升双方好感度的行为。","x":-2799,"y":8859,"width":1159,"height":60,"color":"1"},
		{"id":"a8e7e61244c2fa84","type":"text","text":"需容忍行为是被动方对主动方半好感度以上才能够容忍甚至喜欢的行为。如果被动方对主动方的好感低于半好感度，那主动方的需容忍行为是不能接受的，甚至会因此降低被动方对主动方的好感度。\n在试探阶段，逐步准备试探对方能否接受自己所做的需容忍行为，这是一个非常重要的重点。\n角色显的油腻，有很大一部分原因是在不知道对方对自己好感度，或明知好感不足的时候，就肆无忌惮地对对方进行需容忍行为，不尊重对方感受。","x":-2780,"y":8989,"width":1120,"height":120,"color":"2"},
		{"id":"6d7de135a0ac7f1a","type":"text","text":"- 身体上的亲密接触，尤其敏感部位的亲密接触。\n- 与对方做一般情况下一个人就可以完成或者一个人才能做的行为，体现和对方的亲如一人（例如给对方喂食、穿衣、共用耳机等，同性特有的互换衣服来穿，给对方洗澡等）。\n- 突破对方的安全距离。\n","x":-2780,"y":9152,"width":1120,"height":135},
		{"id":"4a8fab59e12e24da","type":"text","text":"即在很敏锐地察觉到对方的不好情绪，或者通过其他方式得知对方的不好情绪后，会想办法进行安抚。","x":-2780,"y":10289,"width":1120,"height":60},
		{"id":"0b0139a14ef70d94","type":"text","text":"陪伴对方去参与一些活动、事件、场景，尤其是一些对方平时会参与的但自己在产生好感前却一般不会去参与的活动、 事件、场景。","x":-2780,"y":11029,"width":1120,"height":60},
		{"id":"4cb2fe6976424533","type":"text","text":"即在爱情关系中将对方视为自己的所有物而做出的行为。常见的设计思路：\n- 争风吃醋\n- 产生对方可能不喜欢或者不再喜欢自己的危机感\n- 向其他人尤其可能成为情敌的人宣示主权等","x":-2780,"y":9609,"width":1120,"height":160},
		{"id":"996494823a6155ab","type":"text","text":"即在做决定和选择时，对方往往是考虑的最重要因素之一。","x":-2780,"y":10409,"width":1120,"height":60},
		{"id":"0bed958981825913","type":"text","text":"特殊对待行为只有对对方好感度达到半好感度以上时，才会对对方进行的行为。\n这个是和爱情的排他性有关，是从爱情关系这个连接的唯一性、优先度、坚不可摧程度的外延，也即仅对对方一个人专有的最特殊的关注和待遇。\n读者总体上更喜欢可攻略对象主动对叙事主角做特殊对待行为。","x":-2780,"y":9469,"width":1120,"height":90,"color":"6"},
		{"id":"48fc742c33603816","type":"text","text":"即无条件地信赖和包容对方。常见的设计思路：\n- 能轻易且毫无保留地和对方分享自己的秘密\n- 即使所有人都怀疑对方也无条件地相信对方\n- 绝对信守与对方的承诺等","x":-2780,"y":9829,"width":1120,"height":160},
		{"id":"c166c9abde7c74e9","type":"text","text":"关联行为即两人对对方的好感度处于半好感度以上，已经建立了一定程度的联系才会出现的行为。","x":-2780,"y":10569,"width":1120,"height":60,"color":"4"},
		{"id":"a87d0ba94fb9eb85","type":"text","text":"主动方要被动方配合做其不想做或不太想做的行为，被动方虽然不想，但最终还是做了。一旦此行为发生，主动方最好为被动方做出“补偿”，无条件的妥协会造成双方关系上的不平衡，从而破坏双方感情。","x":-2780,"y":9329,"width":1120,"height":60},
		{"id":"4ca368683ab68f79","type":"text","text":"即双方有着很高的默契。常见设计思路：\n- 两人不约而同地做同一件事\n- 两人无需交流也能自然地配合\n- 两人彼此之间养成了对方的一部分小习惯等","x":-2780,"y":10689,"width":1120,"height":160},
		{"id":"6d01eb931f78b896","type":"text","text":"即为对方好，或为维持与对方的情侣关系，或为两人能一直在一起，主动做出不计回报的牺牲。","x":-2780,"y":10049,"width":1120,"height":60},
		{"id":"9f5f78172222f5c3","type":"text","text":"即将一些自己生活体会到的快乐美好等情绪或者好的体验用一定的方式分享给对方。分享行为是一个可以在零好感时主动为作为朋友的对方做的行为，但是半好感以上的时候做，往往代表着不一样的意义和心境。","x":-2780,"y":10909,"width":1120,"height":60},
		{"id":"cb63e82db88fd796","type":"text","text":"即在某些事情上，对待对方与对待其他人完全不同。例如不让人碰的杯子可以对对方去用。","x":-2780,"y":10169,"width":1120,"height":60}
	],
