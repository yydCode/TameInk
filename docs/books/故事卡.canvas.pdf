		{"id":"7e46516bd0a5a342","type":"group","x":-1400,"y":1600,"width":320,"height":80,"color":"3","label":"临危受命"},
		{"id":"ba08acef51104816","type":"group","x":-1400,"y":2240,"width":320,"height":80,"color":"6","label":"舞台聚光灯"},
		{"id":"a184f24fea540022","type":"group","x":-1400,"y":2380,"width":320,"height":80,"color":"6","label":"打破预期"},
		{"id":"8350d54b36b2290c","type":"group","x":-1400,"y":2520,"width":320,"height":80,"color":"6","label":"信息差"},
		{"id":"2417fb686fbe938d","type":"group","x":-1400,"y":2660,"width":320,"height":80,"color":"6","label":"拟感成真"},
		{"id":"5a139417ab9a8ef4","type":"group","x":-980,"y":2240,"width":320,"height":80,"color":"6","label":"戏剧三角"},
		{"id":"326a8ea068fc3727","type":"group","x":-980,"y":2380,"width":320,"height":80,"color":"6","label":"过激行为"},
		{"id":"f264dc897781c5cc","type":"group","x":-980,"y":2520,"width":320,"height":80,"color":"6","label":"翻弄风云"},
		{"id":"8b32bdd263544017","type":"group","x":-980,"y":2660,"width":320,"height":80,"color":"6","label":"望远镜"},
		{"id":"23a85441a3217ba3","type":"group","x":-560,"y":2240,"width":320,"height":80,"color":"6","label":"新视角"},
		{"id":"97539f715ea59863","type":"group","x":-560,"y":2380,"width":320,"height":80,"color":"6","label":"反差"},
		{"id":"c83be0760f09ba9a","type":"group","x":-560,"y":2520,"width":320,"height":80,"color":"6","label":"落差"},
		{"id":"d39f72a1adc9639f","type":"group","x":-560,"y":2660,"width":320,"height":80,"color":"6","label":"双刃剑"},
		{"id":"5689b2836146cc4e","type":"group","x":-140,"y":2240,"width":320,"height":80,"color":"6","label":"差异评价"},
		{"id":"baf3a3edb12d646c","type":"group","x":-2339,"y":-300,"width":260,"height":95,"color":"5","label":"④"},
		{"id":"1fd3f9b91f34468a","type":"group","x":-2339,"y":-620,"width":260,"height":90,"color":"5","label":"②"},
		{"id":"7d621d95da68e17f","type":"group","x":-2698,"y":-1020,"width":280,"height":60,"color":"#1eb8cc","label":"日常生活"},
		{"id":"b948ff143647d327","type":"group","x":-2698,"y":-620,"width":280,"height":60,"color":"5","label":"冒险开始"},
		{"id":"07f10e3cb2e17ad0","type":"group","x":-2698,"y":-497,"width":280,"height":60,"color":"5","label":"深入虎穴"},
		{"id":"f9e26d875c2da941","type":"group","x":-2698,"y":-387,"width":280,"height":60,"color":"5","label":"获得奖励"},
		{"id":"ef9bf34f455cdb94","type":"group","x":-2698,"y":-142,"width":280,"height":60,"color":"5","label":"发生改变"},
		{"id":"d7d4a1d7cbd0c1c5","type":"group","x":-2339,"y":-142,"width":260,"height":60,"color":"5","label":"⑤"},
		{"id":"35ff5365f2cf2003","type":"group","x":-2698,"y":-891,"width":280,"height":51,"color":"5","label":"冒险原因的产生"},
		{"id":"57b55bf675914a2b","type":"group","x":-2698,"y":-259,"width":280,"height":50,"color":"5","label":"回归日常"},
		{"id":"e0ecc50618107461","type":"text","text":"得到某个资格物品给予的考验。","x":-140,"y":-340,"width":320,"height":80,"color":"5"},
		{"id":"463a7d5aa306518d","type":"text","text":"","x":-980,"y":-880,"width":320,"height":80,"color":"5"},
		{"id":"bacf01b15fa17a72","type":"text","text":"进入一个学院/师门进行一段学习。","x":-1400,"y":-340,"width":320,"height":80,"color":"5"},
		{"id":"045ec7aa289eda63","type":"text","text":"主角教别人，弟子是主角的延伸。","x":-980,"y":-340,"width":320,"height":80,"color":"5"},
		{"id":"6bc6e2c573fb805e","type":"text","text":"","x":-560,"y":-340,"width":320,"height":80,"color":"5"},
		{"id":"b8483668a8123608","type":"text","text":"主角在主线上处于危险，寻求出路。","x":-980,"y":-1020,"width":320,"height":80,"color":"5"},
		{"id":"934de7d0ae2933ba","type":"text","text":"保护一个人，一个物，一个地方的状态等等。和冒险之旅经常融合。","x":-980,"y":-600,"width":320,"height":80,"color":"5"},
		{"id":"a2f78c52ebb2ea29","type":"text","text":"主角的状态对于完成任务是艰难的，但是主角还是要完成任务。","x":-980,"y":-740,"width":320,"height":80,"color":"5"},
		{"id":"f569eb998d91a0ff","type":"text","text":"一个人或一群人陷入困境的时候拉出来。变种，妙手回春。","x":-560,"y":-880,"width":320,"height":80,"color":"5"},
		{"id":"a0004fb623a7c20f","type":"text","text":"高难度，如《诡秘之主》。","x":-560,"y":-1020,"width":320,"height":80,"color":"5"},
		{"id":"fcba8d25c12cc140","type":"text","text":"正邪两方争斗。","x":-1400,"y":-1020,"width":320,"height":80,"color":"5"},
		{"id":"189da665821a7213","type":"text","text":"原来在高位，由于一些原因失去了，重新回到高位。","x":-1400,"y":-740,"width":320,"height":80,"color":"5"},
		{"id":"8d06cb1f38dca65b","type":"text","text":"不一定是苦大仇深，主角对反派做的事，要和反派做的恶行程度相当。","x":-1400,"y":-600,"width":320,"height":80,"color":"5"},
		{"id":"50c98d15099db571","type":"text","text":"\n从低到高、升级、事业的从小到大等。","x":-1400,"y":-1160,"width":320,"height":80,"color":"5"},
		{"id":"46032290ae0dc6d3","type":"text","text":"宝不一定是宝物，对主角有用就行。","x":-980,"y":-1160,"width":320,"height":80,"color":"5"},
		{"id":"981741142d35b814","type":"text","text":"现实生活受到类似游戏的影响。","x":-560,"y":-1160,"width":320,"height":80,"color":"5"},
		{"id":"d8419c4f906d17f7","type":"text","text":"门槛高，上限低，保下限。结构固定，容易创作。","x":-1400,"y":-880,"width":320,"height":80,"color":"5"},
		{"id":"84e950c23ac623fb","type":"text","text":"困境分为危机和阻碍，不能是因为主角造成的。\n危机是危及到主角的已有利益。\n阻碍是主角想要的利益被人阻挡。","x":-1400,"y":760,"width":320,"height":80,"color":"5"},
		{"id":"735d6c2823b39b29","type":"text","text":"","x":-1400,"y":1320,"width":320,"height":80,"color":"5"},
		{"id":"be835dbfdf9e4568","type":"text","text":"有人帮主角，主动或无意，有偿或无偿。","x":-1400,"y":1460,"width":320,"height":80,"color":"5"},
		{"id":"59215ab3389a807f","type":"text","text":"","x":-1400,"y":1600,"width":320,"height":80,"color":"5"},
		{"id":"9b5cd6413e7a99d2","type":"text","text":"","x":-1400,"y":900,"width":320,"height":80,"color":"5"},
		{"id":"059cf877c18bb5f4","type":"text","text":"美救英雄也行。","x":-1400,"y":1040,"width":320,"height":80,"color":"5"},
		{"id":"c4162b8669db10e1","type":"text","text":"举例：主角去和反派都去A地拿神器B，主角路上救了一个少女C，主角和反派到了A发现B已被人拿走，正好这个人是C，回报给了主角。","x":-1400,"y":1180,"width":320,"height":80,"color":"5"},
		{"id":"cdb4043513fa0184","type":"text","text":"角色在故事中发生成长，主要包括人格上的成长和能力上的成长。","x":-1400,"y":80,"width":320,"height":80,"color":"5"},
		{"id":"58ddf42df80c416d","type":"text","text":"","x":-1400,"y":220,"width":320,"height":80,"color":"5"},
		{"id":"fcc177e1c1b1239a","type":"text","text":"","x":-1400,"y":360,"width":320,"height":80,"color":"5"},
		{"id":"b337ff51f3a988ce","type":"text","text":"","x":-1400,"y":500,"width":320,"height":80,"color":"5"},
		{"id":"b441bb4e36c6efa1","type":"text","text":"","x":-1400,"y":-200,"width":320,"height":80,"color":"5"},
		{"id":"b1896516ab916158","type":"text","text":"","x":-1400,"y":-60,"width":320,"height":80,"color":"5"},
		{"id":"72a1cfa90ec0df2a","type":"text","text":"","x":-980,"y":1460,"width":320,"height":80,"color":"5"},
		{"id":"5842e1fd264dd51f","type":"text","text":"看帖","x":-980,"y":1600,"width":320,"height":80,"color":"5"},
		{"id":"c9560df6f27366a1","type":"text","text":"CP行为，让其他人羡慕。","x":-560,"y":1600,"width":320,"height":80,"color":"#f08f8f"},
		{"id":"2843caad5cc04576","type":"text","text":"主角身边的环境有了巨大的变化，一般有戏剧性。两个分支，出水之鱼、入水之鱼。","x":-560,"y":360,"width":320,"height":80,"color":"5"},
		{"id":"42956d99bd3a1279","type":"text","text":"主角渔翁得利，主角强大成为各势利争抢对象，主角选择一个势利帮助他成功。","x":-140,"y":360,"width":320,"height":80,"color":"5"},
		{"id":"b7ac6b38e88b49d2","type":"text","text":"小的代价获得巨大收益。","x":-560,"y":760,"width":320,"height":80,"color":"5"},
		{"id":"a821d222ee0a3771","type":"text","text":"","x":-560,"y":900,"width":320,"height":80,"color":"5"},
		{"id":"67bdb6efc93e5176","type":"text","text":"因为爱情得到好处。","x":-140,"y":760,"width":320,"height":80,"color":"#f08f8f"},
		{"id":"c692914cf037b08e","type":"text","text":"","x":-140,"y":900,"width":320,"height":80,"color":"#f08f8f"},
		{"id":"d52893c16959abe8","type":"text","text":"","x":-980,"y":500,"width":320,"height":80,"color":"5"},
		{"id":"d9b4fd7d8f0a9518","type":"text","text":"拥有某个神器，别人知道来抢，或者隐藏信息不被人知道。","x":-560,"y":500,"width":320,"height":80,"color":"5"},
		{"id":"4917d2da0f7446bc","type":"text","text":"1 宗门大比，校园祭，拍卖会等等。","x":-140,"y":500,"width":320,"height":80,"color":"5"},
		{"id":"da8d2e759eb7041e","type":"text","text":"","x":-560,"y":1040,"width":320,"height":80,"color":"5"},
		{"id":"90675e50f0ef6014","type":"text","text":"","x":-140,"y":80,"width":320,"height":80,"color":"5"},
		{"id":"0fc6f6e64d851446","type":"text","text":"","x":-140,"y":220,"width":320,"height":80,"color":"5"},
		{"id":"50ecd9ca25f28063","type":"text","text":"","x":-560,"y":1460,"width":320,"height":80,"color":"#f08f8f"},
		{"id":"52ca5eadec25a362","type":"text","text":"主角把一般的东西变成神器。","x":-140,"y":1040,"width":320,"height":80,"color":"5"},
		{"id":"a237ddaa3e2d134d","type":"text","text":"主角在一个密闭的空间或时间。有一个危险源迫使主角逃出去更好。\n\n","x":-560,"y":-200,"width":320,"height":80,"color":"5"},
		{"id":"63fbdbe1bb0f806d","type":"text","text":"缺少情报的副本。","x":-560,"y":-60,"width":320,"height":80,"color":"5"},
		{"id":"15d9d9f9693ad16b","type":"text","text":"","x":-560,"y":80,"width":320,"height":80,"color":"5"},
		{"id":"cfb8bc4533cbf9a2","type":"text","text":"放松\n","x":-560,"y":220,"width":320,"height":80,"color":"5"},
		{"id":"e4c4702bf3551cb9","type":"text","text":"","x":-980,"y":1180,"width":320,"height":80,"color":"5"},
		{"id":"92b3cec110413c71","type":"text","text":"","x":-980,"y":1320,"width":320,"height":80,"color":"5"},
		{"id":"62e13182a4629a20","type":"text","text":"主角在一个环境受到不同的待遇，有好有差。","x":-560,"y":1180,"width":320,"height":80,"color":"5"},
		{"id":"5d6a4fdebdbaf1c9","type":"text","text":"两个人或者和假想的人。怀疑自己不是唯一的。","x":-560,"y":1320,"width":320,"height":80,"color":"#f08f8f"},
		{"id":"79da3a02a88d95b7","type":"text","text":"","x":-980,"y":-60,"width":320,"height":80,"color":"5"},
		{"id":"0c11368515a6836a","type":"text","text":"","x":-980,"y":760,"width":320,"height":80,"color":"5"},
		{"id":"1cb33b6f54b3a0bc","type":"text","text":"主角有别人没有的信息，主角根据这个信息做出了有别常人的行为，最后证明了主角是对的。","x":-980,"y":900,"width":320,"height":80,"color":"5"},
		{"id":"785ae3bd6a811e2a","type":"text","text":"因为困境的本身得到了好处。比如猴子获得火眼金睛。","x":-980,"y":1040,"width":320,"height":80,"color":"5"},
		{"id":"ff84cdc6469f0c01","type":"text","text":"","x":-140,"y":-200,"width":320,"height":80,"color":"5"},
		{"id":"7ea50add9bd38087","type":"text","text":"看帖","x":-140,"y":-60,"width":320,"height":80,"color":"5"},
		{"id":"cb370572156e4ae4","type":"text","text":"帮助别人。","x":-980,"y":80,"width":320,"height":80,"color":"5"},
		{"id":"8c877d7c84be40ba","type":"text","text":"","x":-980,"y":220,"width":320,"height":80,"color":"5"},
		{"id":"a8d470815a53361d","type":"text","text":"","x":-980,"y":360,"width":320,"height":80,"color":"5"},
		{"id":"ff17f429691f2c23","type":"text","text":"老师说道具卡系统还未开发完成，只展示了技法卡，技法卡用来和小故事卡一起用，调整小故事卡。\n\n下面是个人理解，请批判看待。\n我个人认为道具卡就是类似一种“润色”的方法，他不是遣词造句上的润色，而是用于提高戏剧性的润色。\n为什么这么说，小故事卡是源于三大驱动力，小故事卡提供了情绪，技法卡不提供情绪。\n戏剧性、矛盾、欲望/恐惧，我认为矛盾和欲望是主要情绪的来源，而技法卡更多的提供了戏剧性。","x":-1400,"y":1840,"width":1580,"height":180},
		{"id":"6fd3ab312b07c9ae","type":"text","text":"角色本来在“台下”，意外进入舞台成为焦点。","x":-1400,"y":2240,"width":320,"height":80,"color":"5"},
		{"id":"ff1c63e7f1237ec6","type":"text","text":"","x":-1400,"y":2380,"width":320,"height":80,"color":"5"},
		{"id":"772ac53ee421882e","type":"text","text":"看帖","x":-1400,"y":2520,"width":320,"height":80,"color":"5"},
		{"id":"75eff96ca5c7919d","type":"text","text":"恐怖故事用的\n","x":-1400,"y":2660,"width":320,"height":80,"color":"5"},
		{"id":"0c8fd42ed61b48ae","type":"text","text":"卡普曼戏剧三角\n","x":-980,"y":2240,"width":320,"height":80,"color":"5"},
		{"id":"b92d9fed45b0a44c","type":"text","text":"","x":-980,"y":2380,"width":320,"height":80,"color":"5"},
		{"id":"75d0f5a9121240c7","type":"text","text":"","x":-980,"y":2520,"width":320,"height":80,"color":"5"},
		{"id":"737b752d912f8dfb","type":"text","text":"","x":-980,"y":2660,"width":320,"height":80,"color":"5"},
		{"id":"1d8071e9feea4477","type":"text","text":"","x":-560,"y":2240,"width":320,"height":80,"color":"5"},
		{"id":"8f11f03286a3a6de","type":"text","text":"","x":-560,"y":2380,"width":320,"height":80,"color":"5"},
		{"id":"0a749c77072d6c5a","type":"text","text":"","x":-560,"y":2520,"width":320,"height":80,"color":"5"},
		{"id":"b410ce19cfc2df92","type":"text","text":"","x":-560,"y":2660,"width":320,"height":80,"color":"5"},
		{"id":"80983b147006be00","type":"text","text":"","x":-140,"y":2240,"width":320,"height":80,"color":"5"},
		{"id":"1e33546072105d59","type":"text","text":"###### ➜故事卡系统和其他理论的区别\n\n经常被用来在网文学习里使用的理论，比如马斯洛需求理论，经常提及的概念，比如期待感、爽感，情绪拉扯。\n这些东西我们都很熟悉了，但是我还是每天在问，如何拉期待？如何制造爽点？如何拉扯情绪？\n因➜果\n这些理论，这些概念都是对的，都是重要的。但是，他们对应的是“果”，是我们的文字最终应该是什么样子。\n故事卡系统的出发点，则是这个关系中的“因”——驱动力。\n\n###### ➜什么是驱动力\n\n当我们在路上看到一个限速20的标志，我们需要把车速降到20以下，我们可以不会开车，但这是我们都知道应该遵从的“果”。\n当我们真正开车的时候，我们知道驱动汽车前进的是发动机，我们要用合适的转速，合适的齿轮比，才能控制车速。\n发动机就是汽车的驱动力。\n\n我们看小说的时候，会有期待，会有爽感，这是我们的追求，我们写的书应该遵从这个“果”，是什么驱动我们产生了这些感觉呢？\n戏剧性、矛盾、欲望/恐惧。\n\n[凝墨➜小说的驱动力](https://t.zsxq.com/15zXowbPS)\n[凝墨➜三种小说驱动力的关系](https://t.zsxq.com/15PrajwFL)\n\n###### ➜什么是套路\n\n具体的故事的千变万化的，但是套路本身是抽象的、相对确定的，把握了不变的、抽象的套路才能演化具体的、万变的故事。\n\n###### ➜什么是故事卡\n\n故事卡就是对“套路”的建模，从三大驱动力出发，这是我们产生期待感、爽感、情绪上下行的底层逻辑模型。\n他是抽象的，我们加上自己的素材，就可以泛化出不同的故事。\n\n故事卡分为大、中、小三种，最主要的是小故事卡，一系列小故事组成一卷（中），几卷组成一本书（大），小故事卡还提供了情绪的变化。\n\n\n","x":-1400,"y":-2100,"width":1580,"height":780},
		{"id":"42853dbc5b190547","type":"text","text":"###### ➜什么是故事点\n\n故事点是一个标志性的情节，故事点必然在一个故事里面。\n故事点有两种，一种是节点，一种是关键点。\n\n- 节点 ： 将故事分成一个个里程碑式的节点，是将我们思维在宏观和微观视角切换的方法。比如我们要盖一个小区，纵观整个小区的时候，我们看到的是一幢幢的单元楼，目光在一个单元的时候，是一层层的楼层，站在一层的时候是几户门，进到一户的时候，是几个房间，进到一个房间的时候，是几面墙，进到墙里……，有了这种层级划分，我们不用在打算建一个小区的时候考虑要用多少块砖的问题。同样的一个故事，比如打败魔王，我们分成一个个节点，找到装备➜找到队友➜打败魔王手下➜打败魔王，找装备这个节点又可以分成找到剑➜找到盾➜找到魔杖，找到剑的这个节点又可以再细分。\n\n- 关键点 ： 当我们将找到剑这个节点再往下分，想拿剑（目标产生）➜得到拿剑能力（产生了装逼可能）➜拿剑➜打脸（实现目标）➜得到剑（收获），我们得到的这些点是特殊的点，是和小故事卡相结合的点，小故事卡是根据三大驱动力总结的底层的逻辑，所以这些点就是最关键的点，这些点来实现装逼和神器认主，并且目前这些关键点都是成套确定的。\n\n###### ➜什么是层级结构\n\n通过故事点细分的方式，直到节点➜关键点的细分，从上面的例子中得到了最常用的三层结构，用来帮我们组织掌握故事的整体和细节。\n\n###### ➜故事点与起承转合\n\n故事点和起承转合并不冲突，我们从上面的例子中也能看到起承转合，但是你是如何从起承转合得到一个装逼的故事呢？而这就是故事卡系统结合故事点层级轻松做到的事情。\n","x":-1400,"y":2860,"width":1580,"height":500},
		{"id":"3e691f353e2895ee","type":"text","text":"","x":-980,"y":-200,"width":320,"height":80,"color":"5"},
		{"id":"e700a3aaa34b57bf","type":"text","text":"一级结构是由成套确定的关键点组成的，可以分成事业线和爱情线两种。","x":-1400,"y":3480,"width":1580,"height":120},
		{"id":"845da7b792b0bfcc","type":"text","text":"阻碍消除","x":-706,"y":4300,"width":193,"height":50,"color":"4"},
		{"id":"9f263a51fdf92f6d","type":"text","text":"更换或放弃目标","x":-706,"y":4415,"width":193,"height":50,"color":"4"},
		{"id":"30a85539058f0e0c","type":"text","text":"目标实现","x":-444,"y":4240,"width":163,"height":50,"color":"4"},
		{"id":"f29e223c9480d2d4","type":"text","text":"目标产生","x":-1301,"y":4360,"width":140,"height":50,"color":"3"},
		{"id":"f9fe8672ba70e98d","type":"text","text":"阻碍出现","x":-921,"y":4360,"width":140,"height":50,"color":"5"},
		{"id":"f57885438eff6c86","type":"text","text":"危机出现","x":-1301,"y":4660,"width":180,"height":50,"color":"3"},
		{"id":"f88188954a54a279","type":"text","text":"成功脱离危机","x":-420,"y":4660,"width":163,"height":50,"color":"4"},
